#include <winver.h>
#include "../common/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HW2VR_VERSION_MAJOR, HW2VR_VERSION_MINOR, HW2VR_VERSION_PATCH, 0
 PRODUCTVERSION HW2VR_VERSION_MAJOR, HW2VR_VERSION_MINOR, HW2VR_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "HW2 Frame VR - opengl32.dll proxy for Homeworld 2 Remastered"
            VALUE "FileVersion", HW2VR_VERSION_STR
            VALUE "InternalName", "opengl32"
            VALUE "OriginalFilename", "opengl32.dll"
            VALUE "ProductName", HW2VR_PRODUCT_NAME
            VALUE "ProductVersion", HW2VR_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
